{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outpost Mail",
  "version": "0.0.1",
  "identifier": "io.github.scarylepoo.outpostmail",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -w ui",
    "beforeBuildCommand": "npm run build -w ui"
  },
  "app": {
    "windows": [
      {
        "title": "Outpost",
        "width": 1320,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
